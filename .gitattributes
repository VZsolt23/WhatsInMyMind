# Normalize line endings: LF in the repo, LF in the working tree (see .editorconfig)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Lockfiles: don't show noisy diffs, never auto-merge
yarn.lock -diff merge=binary
